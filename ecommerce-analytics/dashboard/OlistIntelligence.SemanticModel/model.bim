            "dataType": "int64",
            "sourceColumn": "r_score",
            "summarizeBy": "none"
          },
          {
            "name": "f_score",
            "dataType": "int64",
            "sourceColumn": "f_score",
            "summarizeBy": "none"
          },
          {
            "name": "m_score",
            "dataType": "int64",
            "sourceColumn": "m_score",
            "summarizeBy": "none"
          },
          {
            "name": "rfm_cell",
