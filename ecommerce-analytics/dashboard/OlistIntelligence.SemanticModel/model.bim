            "summarizeBy": "none"
          },
          {
            "name": "seller_id",
            "dataType": "string",
            "sourceColumn": "seller_id",
            "summarizeBy": "none"
          },
          {
            "name": "customer_unique_id",
            "dataType": "string",
            "sourceColumn": "customer_unique_id",
            "summarizeBy": "none"
          },
          {
            "name": "order_date",
            "dataType": "dateTime",
            "sourceColumn": "order_date",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "order_month",
            "dataType": "string",
            "sourceColumn": "order_month",
            "summarizeBy": "none"
          },
          {
            "name": "order_quarter",
            "dataType": "string",
            "sourceColumn": "order_quarter",
            "summarizeBy": "none"
          },
          {
            "name": "category",
            "dataType": "string",
            "sourceColumn": "category",
            "summarizeBy": "none"
          },
          {
            "name": "revenue",
            "dataType": "double",
            "sourceColumn": "revenue",
            "summarizeBy": "sum"
          },
          {
            "name": "freight",
            "dataType": "double",
            "sourceColumn": "freight",
            "summarizeBy": "sum"
          },
          {
            "name": "customer_state",
            "dataType": "string",
            "sourceColumn": "customer_state",
            "summarizeBy": "none"
          },
          {
            "name": "seller_state",
            "dataType": "string",
            "sourceColumn": "seller_state",
            "summarizeBy": "none"
          },
          {
            "name": "same_state_delivery",
            "dataType": "boolean",
            "sourceColumn": "same_state_delivery",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "fact_order_items",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Parquet.Document(File.Contents(DataFolder & \"fact_order_items.parquet\")),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"order_id\", type text}, {\"order_item_id\", Int64.Type}, {\"product_id\", type text}, {\"seller_id\", type text}, {\"customer_unique_id\", type text}, {\"order_date\", type date}, {\"order_month\", type text}, {\"order_quarter\", type text}, {\"category\", type text}, {\"revenue\", type number}, {\"freight\", type number}, {\"customer_state\", type text}, {\"seller_state\", type text}, {\"same_state_delivery\", type logical}})",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Item Revenue",
            "expression": "SUM ( fact_order_items[revenue] )",
            "formatString": "\"R$\"#,0",
            "displayFolder": "Revenue",
            "description": "Revenue at line level. Use for product, category and seller visuals."
          },
          {
            "name": "Items Sold",
            "expression": "COUNTROWS ( fact_order_items )",
            "formatString": "#,0",
            "displayFolder": "Volume"
          },
          {
            "name": "Products Sold",
            "expression": "DISTINCTCOUNT ( fact_order_items[product_id] )",
            "formatString": "#,0",
            "displayFolder": "Volume"
          },
          {
            "name": "Avg Item Price",
            "expression": "DIVIDE ( [Item Revenue], [Items Sold] )",
            "formatString": "\"R$\"#,0.00",
            "displayFolder": "Order Value"
          }
        ]
      },
      {
        "name": "dim_customers_segmented",
        "columns": [
