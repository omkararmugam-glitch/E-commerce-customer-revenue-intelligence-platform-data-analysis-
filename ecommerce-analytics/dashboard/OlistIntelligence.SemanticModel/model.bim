{
  "name": "OlistIntelligence",
  "compatibilityLevel": 1550,
  "model": {
    "culture": "en-US",
    "dataAccessOptions": {
      "legacyRedirects": true,
      "returnErrorValuesAsNull": true
    },
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "sourceQueryCulture": "en-US",
    "tables": [
      {
        "name": "fact_orders",
        "columns": [
          {
            "name": "order_id",
            "dataType": "string",
            "sourceColumn": "order_id",
            "summarizeBy": "none"
          },
          {
            "name": "customer_unique_id",
            "dataType": "string",
            "sourceColumn": "customer_unique_id",
            "summarizeBy": "none"
          },
          {
            "name": "order_date",
            "dataType": "dateTime",
            "sourceColumn": "order_date",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "order_timestamp",
            "dataType": "dateTime",
            "sourceColumn": "order_timestamp",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd hh:nn"
          },
          {
            "name": "order_year",
            "dataType": "int64",
            "sourceColumn": "order_year",
            "summarizeBy": "none"
          },
          {
            "name": "order_month",
            "dataType": "string",
            "sourceColumn": "order_month",
            "summarizeBy": "none"
          },
          {
            "name": "order_quarter",
            "dataType": "string",
            "sourceColumn": "order_quarter",
            "summarizeBy": "none"
          },
          {
            "name": "order_weekday",
            "dataType": "string",
            "sourceColumn": "order_weekday",
            "summarizeBy": "none"
          },
          {
            "name": "order_hour",
            "dataType": "int64",
            "sourceColumn": "order_hour",
            "summarizeBy": "none"
          },
          {
            "name": "revenue",
            "dataType": "double",
            "sourceColumn": "revenue",
            "summarizeBy": "sum"
          },
          {
            "name": "freight",
            "dataType": "double",
            "sourceColumn": "freight",
            "summarizeBy": "sum"
          },
          {
            "name": "items_in_order",
            "dataType": "int64",
            "sourceColumn": "items_in_order",
            "summarizeBy": "sum"
          },
          {
            "name": "distinct_products",
            "dataType": "int64",
            "sourceColumn": "distinct_products",
            "summarizeBy": "none"
          },
          {
            "name": "distinct_sellers",
            "dataType": "int64",
            "sourceColumn": "distinct_sellers",
            "summarizeBy": "none"
          },
          {
            "name": "avg_item_price",
            "dataType": "double",
            "sourceColumn": "avg_item_price",
            "summarizeBy": "none"
          },
          {
            "name": "is_multi_item",
            "dataType": "boolean",
            "sourceColumn": "is_multi_item",
            "summarizeBy": "none"
          },
          {
            "name": "payment_type",
            "dataType": "string",
            "sourceColumn": "payment_type",
            "summarizeBy": "none"
          },
          {
            "name": "max_installments",
            "dataType": "double",
            "sourceColumn": "max_installments",
            "summarizeBy": "none"
          },
          {
            "name": "review_score",
            "dataType": "double",
            "sourceColumn": "review_score",
            "summarizeBy": "none"
          },
          {
            "name": "delivery_days",
            "dataType": "double",
            "sourceColumn": "delivery_days",
            "summarizeBy": "none"
          },
          {
            "name": "estimated_days",
            "dataType": "double",
            "sourceColumn": "estimated_days",
            "summarizeBy": "none"
          },
          {
            "name": "delivery_vs_estimate_days",
            "dataType": "double",
            "sourceColumn": "delivery_vs_estimate_days",
            "summarizeBy": "none"
          },
          {
            "name": "is_late",
            "dataType": "boolean",
            "sourceColumn": "is_late",
            "summarizeBy": "none"
          },
          {
            "name": "customer_state",
            "dataType": "string",
            "sourceColumn": "customer_state",
            "summarizeBy": "none"
          },
          {
            "name": "customer_city",
            "dataType": "string",
            "sourceColumn": "customer_city",
            "summarizeBy": "none"
          },
          {
            "name": "is_truncated_period",
            "dataType": "boolean",
            "sourceColumn": "is_truncated_period",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "fact_orders",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Parquet.Document(File.Contents(DataFolder & \"fact_orders.parquet\")),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"order_id\", type text}, {\"customer_unique_id\", type text}, {\"order_date\", type date}, {\"order_timestamp\", type datetime}, {\"order_year\", Int64.Type}, {\"order_month\", type text}, {\"order_quarter\", type text}, {\"order_weekday\", type text}, {\"order_hour\", Int64.Type}, {\"revenue\", type number}, {\"freight\", type number}, {\"items_in_order\", Int64.Type}, {\"distinct_products\", Int64.Type}, {\"distinct_sellers\", Int64.Type}, {\"avg_item_price\", type number}, {\"is_multi_item\", type logical}, {\"payment_type\", type text}, {\"max_installments\", type number}, {\"review_score\", type number}, {\"delivery_days\", type number}, {\"estimated_days\", type number}, {\"delivery_vs_estimate_days\", type number}, {\"is_late\", type logical}, {\"customer_state\", type text}, {\"customer_city\", type text}, {\"is_truncated_period\", type logical}})",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Revenue",
            "expression": "SUM ( fact_orders[revenue] )",
            "formatString": "\"R$\"#,0",
            "displayFolder": "Revenue",
            "description": "Item price on delivered orders. Excludes freight. Use for order-level analysis."
          },
          {
            "name": "Revenue (Trend)",
            "expression": "CALCULATE ( [Total Revenue], dim_date[is_truncated_period] = FALSE () )",
            "formatString": "\"R$\"#,0",
            "displayFolder": "Revenue",
            "description": "Total Revenue excluding the truncated export tail after 2018-08-23. Use on time-series visuals."
          },
          {
            "name": "Total Freight",
            "expression": "SUM ( fact_orders[freight] )",
            "formatString": "\"R$\"#,0",
            "displayFolder": "Revenue",
            "description": "Customer-paid shipping. Never added into revenue."
          },
          {
            "name": "Freight % of Revenue",
            "expression": "DIVIDE ( [Total Freight], [Total Revenue] )",
            "formatString": "0.0%",
            "displayFolder": "Revenue"
          },
          {
            "name": "Revenue MoM %",
            "expression": [
              "VAR isPartial =",
              "    CALCULATE ( COUNTROWS ( dim_date ), dim_date[is_truncated_period] = TRUE () ) > 0",
              "VAR cur = [Revenue (Trend)]",
              "VAR prev = CALCULATE ( [Revenue (Trend)], DATEADD ( dim_date[date], -1, MONTH ) )",
              "RETURN IF ( isPartial, BLANK (), DIVIDE ( cur - prev, prev ) )"
            ],
            "formatString": "0.0%",
            "displayFolder": "Revenue",
            "description": "Month-on-month change in trend revenue. Blank for Aug 2018, which is a partial month."
          },
          {
            "name": "Orders",
            "expression": "DISTINCTCOUNT ( fact_orders[order_id] )",
            "formatString": "#,0",
            "displayFolder": "Volume"
          },
          {
            "name": "Customers",
            "expression": "DISTINCTCOUNT ( fact_orders[customer_unique_id] )",
            "formatString": "#,0",
            "displayFolder": "Volume",
            "description": "Distinct people (customer_unique_id)."
          },
          {
            "name": "AOV (Mean)",
            "expression": "DIVIDE ( [Total Revenue], [Orders] )",
            "formatString": "\"R$\"#,0.00",
            "displayFolder": "Order Value",
            "description": "Mean order value. Skewed by large orders - show beside the median."
          },
          {
            "name": "AOV (Median)",
            "expression": "MEDIAN ( fact_orders[revenue] )",
            "formatString": "\"R$\"#,0.00",
            "displayFolder": "Order Value",
            "description": "Median order value - the typical order. Prefer this headline."
          },
          {
            "name": "AOV (Credit Card)",
            "expression": "CALCULATE ( [AOV (Mean)], KEEPFILTERS ( fact_orders[payment_type] = \"credit_card\" ) )",
            "formatString": "\"R$\"#,0.00",
            "displayFolder": "Order Value",
            "description": "Mean order value on credit-card orders only - the only method with instalments."
          },
          {
            "name": "Multi-Item Order %",
            "expression": "DIVIDE ( CALCULATE ( [Orders], KEEPFILTERS ( fact_orders[is_multi_item] = TRUE () ) ), [Orders] )",
            "formatString": "0.0%",
            "displayFolder": "Order Value"
          },
          {
            "name": "Late Rate %",
            "expression": "DIVIDE ( CALCULATE ( [Orders], KEEPFILTERS ( fact_orders[is_late] = TRUE () ) ), [Orders] )",
            "formatString": "0.0%",
            "displayFolder": "Delivery",
            "description": "Share of orders delivered after the promised date."
          },
          {
            "name": "Avg Delivery Days",
            "expression": "AVERAGE ( fact_orders[delivery_days] )",
            "formatString": "0.0",
            "displayFolder": "Delivery"
          },
          {
            "name": "Avg Review Score",
            "expression": "AVERAGE ( fact_orders[review_score] )",
            "formatString": "0.00",
            "displayFolder": "Satisfaction",
            "description": "Mean of non-blank review scores."
          },
          {
            "name": "One-Star Rate %",
            "expression": [
              "DIVIDE (",
              "    CALCULATE ( COUNTROWS ( fact_orders ), KEEPFILTERS ( fact_orders[review_score] = 1 ) ),",
              "    CALCULATE ( COUNTROWS ( fact_orders ), NOT ISBLANK ( fact_orders[review_score] ) )",
              ")"
            ],
            "formatString": "0.0%",
            "displayFolder": "Satisfaction"
          }
        ]
      },
      {
        "name": "fact_order_items",
        "columns": [
          {
            "name": "order_id",
            "dataType": "string",
            "sourceColumn": "order_id",
            "summarizeBy": "none"
          },
          {
