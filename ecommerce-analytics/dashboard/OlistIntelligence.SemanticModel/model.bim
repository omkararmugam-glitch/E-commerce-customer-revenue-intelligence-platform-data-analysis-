            "sourceColumn": "avg_review_score",
            "summarizeBy": "none"
          },
          {
            "name": "late_orders",
            "dataType": "int64",
            "sourceColumn": "late_orders",
            "summarizeBy": "sum"
          },
          {
            "name": "is_repeat_customer",
            "dataType": "boolean",
            "sourceColumn": "is_repeat_customer",
            "summarizeBy": "none"
          },
          {
