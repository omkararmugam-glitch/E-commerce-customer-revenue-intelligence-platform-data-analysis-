            "dataType": "string",
            "sourceColumn": "risk_tier",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_customers_segmented",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Parquet.Document(File.Contents(DataFolder & \"dim_customers_segmented.parquet\")),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"customer_unique_id\", type text}, {\"customer_state\", type text}, {\"first_order_date\", type date}, {\"last_order_date\", type date}, {\"recency_days\", Int64.Type}, {\"frequency_orders\", Int64.Type}, {\"monetary_revenue\", type number}, {\"avg_order_value\", type number}, {\"total_items\", Int64.Type}, {\"distinct_categories\", Int64.Type}, {\"distinct_sellers\", Int64.Type}, {\"tenure_days\", Int64.Type}, {\"avg_review_score\", type number}, {\"late_orders\", Int64.Type}, {\"is_repeat_customer\", type logical}, {\"r_score\", Int64.Type}, {\"f_score\", Int64.Type}, {\"m_score\", Int64.Type}, {\"rfm_cell\", type text}, {\"rfm_segment\", type text}, {\"kmeans_cluster\", Int64.Type}, {\"kmeans_segment\", type text}, {\"value_decile\", Int64.Type}, {\"risk_tier\", type text}})",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Segment Customers",
            "expression": "COUNTROWS ( dim_customers_segmented )",
            "formatString": "#,0",
            "displayFolder": "Segments"
          },
          {
            "name": "Segment Revenue",
            "expression": "SUM ( dim_customers_segmented[monetary_revenue] )",
            "formatString": "\"R$\"#,0",
            "displayFolder": "Segments"
          },
          {
            "name": "Segment Revenue %",
            "expression": "DIVIDE ( [Segment Revenue], CALCULATE ( [Segment Revenue], ALL ( dim_customers_segmented ) ) )",
            "formatString": "0.0%",
            "displayFolder": "Segments"
          },
          {
            "name": "Repeat Customers",
            "expression": "CALCULATE ( COUNTROWS ( dim_customers_segmented ), KEEPFILTERS ( dim_customers_segmented[is_repeat_customer] = TRUE () ) )",
            "formatString": "#,0",
            "displayFolder": "Segments"
          },
          {
            "name": "Repeat Rate %",
            "expression": "DIVIDE ( [Repeat Customers], [Segment Customers] )",
            "formatString": "0.0%",
            "displayFolder": "Segments",
            "description": "Share of customers with more than one order (~3%)."
          },
          {
            "name": "Avg Customer Value",
            "expression": "AVERAGE ( dim_customers_segmented[monetary_revenue] )",
            "formatString": "\"R$\"#,0.00",
            "displayFolder": "Segments"
          }
        ]
      },
      {
