      {
        "name": "fact_cohort_retention",
        "columns": [
          {
            "name": "cohort_month",
            "dataType": "string",
            "sourceColumn": "cohort_month",
            "summarizeBy": "none"
          },
          {
            "name": "months_since_first_purchase",
            "dataType": "int64",
            "sourceColumn": "months_since_first_purchase",
            "summarizeBy": "none"
          },
          {
            "name": "retention_pct",
            "dataType": "double",
            "sourceColumn": "retention_pct",
            "summarizeBy": "none"
          },
          {
            "name": "cohort_size",
            "dataType": "int64",
            "sourceColumn": "cohort_size",
            "summarizeBy": "none"
          },
          {
            "name": "retained_customers",
            "dataType": "int64",
            "sourceColumn": "retained_customers",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "fact_cohort_retention",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Parquet.Document(File.Contents(DataFolder & \"fact_cohort_retention.parquet\")),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"cohort_month\", type text}, {\"months_since_first_purchase\", Int64.Type}, {\"retention_pct\", type number}, {\"cohort_size\", Int64.Type}, {\"retained_customers\", Int64.Type}})",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Avg Retention %",
            "expression": "DIVIDE ( AVERAGE ( fact_cohort_retention[retention_pct] ), 100 )",
            "formatString": "0.00%",
            "displayFolder": "Cohorts"
          },
          {
            "name": "Retention % After Month 0",
            "expression": "CALCULATE ( [Avg Retention %], KEEPFILTERS ( fact_cohort_retention[months_since_first_purchase] > 0 ) )",
            "formatString": "0.00%",
            "displayFolder": "Cohorts",
            "description": "Excludes month 0, which is always 100%."
          }
        ]
      },
      {
        "name": "dim_cohort_summary",
        "columns": [
          {
            "name": "cohort_month",
            "dataType": "string",
            "sourceColumn": "cohort_month",
            "summarizeBy": "none"
          },
          {
            "name": "new_customers",
            "dataType": "int64",
            "sourceColumn": "new_customers",
            "summarizeBy": "sum"
          },
          {
            "name": "revenue",
            "dataType": "double",
            "sourceColumn": "revenue",
            "summarizeBy": "sum"
          },
          {
            "name": "revenue_per_customer",
            "dataType": "double",
            "sourceColumn": "revenue_per_customer",
            "summarizeBy": "none"
          },
          {
            "name": "months_observed",
            "dataType": "int64",
            "sourceColumn": "months_observed",
            "summarizeBy": "none"
          },
          {
            "name": "ever_repeated_pct",
            "dataType": "double",
            "sourceColumn": "ever_repeated_pct",
            "summarizeBy": "none"
          },
          {
            "name": "repeat_rate_3mo_pct",
            "dataType": "double",
            "sourceColumn": "repeat_rate_3mo_pct",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "dim_cohort_summary",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Parquet.Document(File.Contents(DataFolder & \"dim_cohort_summary.parquet\")),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"cohort_month\", type text}, {\"new_customers\", Int64.Type}, {\"revenue\", type number}, {\"revenue_per_customer\", type number}, {\"months_observed\", Int64.Type}, {\"ever_repeated_pct\", type number}, {\"repeat_rate_3mo_pct\", type number}})",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "3-Month Repeat Rate %",
            "expression": "DIVIDE ( AVERAGE ( dim_cohort_summary[repeat_rate_3mo_pct] ), 100 )",
            "formatString": "0.00%",
            "displayFolder": "Cohorts",
            "description": "Fair cross-cohort comparison (equal 3-month window)."
          }
        ]
      },
      {
        "name": "fact_revenue_forecast",
        "columns": [
          {
            "name": "period",
            "dataType": "dateTime",
            "sourceColumn": "period",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd"
          },
          {
            "name": "period_label",
            "dataType": "string",
            "sourceColumn": "period_label",
            "summarizeBy": "none"
          },
          {
            "name": "type",
            "dataType": "string",
            "sourceColumn": "type",
            "summarizeBy": "none"
          },
          {
            "name": "actual",
            "dataType": "double",
            "sourceColumn": "actual",
            "summarizeBy": "sum"
          },
          {
            "name": "forecast",
            "dataType": "double",
            "sourceColumn": "forecast",
            "summarizeBy": "sum"
          },
          {
            "name": "lower_95",
            "dataType": "double",
            "sourceColumn": "lower_95",
            "summarizeBy": "none"
          },
          {
            "name": "upper_95",
            "dataType": "double",
            "sourceColumn": "upper_95",
            "summarizeBy": "none"
          },
          {
            "name": "value",
            "dataType": "double",
            "sourceColumn": "value",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "fact_revenue_forecast",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Parquet.Document(File.Contents(DataFolder & \"fact_revenue_forecast.parquet\")),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"period\", type date}, {\"period_label\", type text}, {\"type\", type text}, {\"actual\", type number}, {\"forecast\", type number}, {\"lower_95\", type number}, {\"upper_95\", type number}, {\"value\", type number}})",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Actual Revenue",
            "expression": "SUM ( fact_revenue_forecast[actual] )",
            "formatString": "\"R$\"#,0",
            "displayFolder": "Forecast"
          },
          {
            "name": "Forecast Revenue",
            "expression": "SUM ( fact_revenue_forecast[forecast] )",
            "formatString": "\"R$\"#,0",
            "displayFolder": "Forecast",
            "description": "ARIMA(0,1,1) point forecast."
          },
          {
            "name": "Forecast Lower 95",
            "expression": "SUM ( fact_revenue_forecast[lower_95] )",
            "formatString": "\"R$\"#,0",
            "displayFolder": "Forecast",
            "description": "Per-month bound. Do not total across months: summed bounds are not a valid interval."
          },
          {
            "name": "Forecast Upper 95",
            "expression": "SUM ( fact_revenue_forecast[upper_95] )",
            "formatString": "\"R$\"#,0",
            "displayFolder": "Forecast",
            "description": "Per-month bound. Do not total across months: summed bounds are not a valid interval."
          },
          {
            "name": "Next Month Lower 95",
            "expression": [
              "VAR firstPeriod =",
              "    CALCULATE ( MIN ( fact_revenue_forecast[period] ), fact_revenue_forecast[type] = \"forecast\" )",
              "RETURN CALCULATE ( SUM ( fact_revenue_forecast[lower_95] ), fact_revenue_forecast[period] = firstPeriod )"
            ],
            "formatString": "\"R$\"#,0",
            "displayFolder": "Forecast",
            "description": "Lower 95% bound for the first forecast month."
          },
          {
            "name": "Next Month Upper 95",
            "expression": [
              "VAR firstPeriod =",
              "    CALCULATE ( MIN ( fact_revenue_forecast[period] ), fact_revenue_forecast[type] = \"forecast\" )",
              "RETURN CALCULATE ( SUM ( fact_revenue_forecast[upper_95] ), fact_revenue_forecast[period] = firstPeriod )"
            ],
            "formatString": "\"R$\"#,0",
            "displayFolder": "Forecast",
            "description": "Upper 95% bound for the first forecast month."
          },
          {
            "name": "Next Month Forecast",
            "expression": [
              "VAR firstPeriod =",
              "    CALCULATE ( MIN ( fact_revenue_forecast[period] ), fact_revenue_forecast[type] = \"forecast\" )",
              "RETURN CALCULATE ( [Forecast Revenue], fact_revenue_forecast[period] = firstPeriod )"
            ],
            "formatString": "\"R$\"#,0",
            "displayFolder": "Forecast",
            "description": "First forecast month."
          }
        ]
      },
      {
        "name": "dim_forecast_model_comparison",
        "columns": [
          {
            "name": "model",
            "dataType": "string",
            "sourceColumn": "model",
            "summarizeBy": "none"
          },
          {
